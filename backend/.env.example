# Copy this file to .env and fill in real values. Never commit .env.

# Origins allowed to call the API (the Vite dev server)
CORS_ORIGINS=http://localhost:5173

# --- Google Drive ---
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# --- Embeddings and vector store ---
# Set OPENAI_EMBEDDING_MODEL to use OpenAI embeddings (needs OPENAI_API_KEY);
# leave it empty to use the free local model in EMBEDDING_MODEL.
# Changing the embedding model triggers a full re-index on the next sync.
OPENAI_EMBEDDING_MODEL=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=./data/chroma_db
SYNC_STATE_FILE=./data/sync_state.json
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=4
# Cosine distance cutoff (lower = stricter). Chunks farther than this are ignored.
MAX_DISTANCE=0.75
# Earlier chat messages sent with each question so follow-ups keep context (0 = none)
CHAT_HISTORY_MAX_MESSAGES=6

# --- LLM provider: modal | openai | groq | gemini | custom ---
LLM_PROVIDER=modal
LLM_MODEL=Qwen/Qwen3.8-Max-VL-Thinking
# Optional override; defaults exist for each provider (required for "custom")
LLM_BASE_URL=
# Used by the openai provider and OpenAI embeddings (the key only, e.g. sk-...)
OPENAI_API_KEY=
# Used by groq / gemini / custom
LLM_API_KEY=
# Used by the modal provider
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# --- Greetings and small talk (restart the backend after changing these) ---
# Project name used in small-talk replies; empty = replies say "this project"
PROJECT_NAME=
# false = send every message, including "hi", to document search (RAG)
CONVERSATIONAL_REPLIES_ENABLED=true
# Small-talk knowledge base (backend/app/small_talk/small_talk_kb.json): fuzzy and semantic matching.
# false = phrase rules only
SMALL_TALK_KB_ENABLED=true
# Semantic matching in the small_talk_* ChromaDB collection; false = fuzzy only, nothing is embedded
SMALL_TALK_SEMANTIC_ENABLED=true
# After RAG finds nothing: reply to missed small talk, and greet back on a not-found
SMALL_TALK_SAFETY_NET_ENABLED=true
# Longer messages skip the knowledge base
SMALL_TALK_MAX_WORDS=8
# Letter-by-letter similarity for typos and shorthand, and the required lead over real-question anchors
SMALL_TALK_FUZZY_THRESHOLD=0.85
SMALL_TALK_FUZZY_MARGIN=0.15
# Calibrated for local all-MiniLM-L6-v2 (0 false positives on 30 real questions).
# Recalibrate whenever EMBEDDING_MODEL or OPENAI_EMBEDDING_MODEL changes:
#   cd backend && python -m app.scripts.calibrate_small_talk
SMALL_TALK_SEMANTIC_THRESHOLD=0.75
SMALL_TALK_SEMANTIC_MARGIN=0.10
# Polite reply (naming PROJECT_NAME) to abusive messages, without search or the LLM.
# Abuse mixed into a real question is removed and the question is answered as usual.
ABUSIVE_LANGUAGE_FILTER_ENABLED=true
