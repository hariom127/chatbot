# Copy this file to .env and fill in real values. Never commit .env.

# Origins allowed to call the API (the Vite dev server)
CORS_ORIGINS=http://localhost:5173

# --- Google Drive ---
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# --- Local embeddings and vector store ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=./data/chroma_db
SYNC_STATE_FILE=./data/sync_state.json
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=4
# Cosine distance cutoff (lower = stricter). Chunks farther than this are ignored.
MAX_DISTANCE=0.75

# --- LLM provider: modal | openai | groq | gemini | custom ---
LLM_PROVIDER=modal
LLM_MODEL=Qwen/Qwen3.8-Max-VL-Thinking
# Optional override; defaults exist for each provider (required for "custom")
LLM_BASE_URL=
# Used by openai / groq / gemini / custom
LLM_API_KEY=
# Used by the modal provider
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
